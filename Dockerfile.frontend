# Dockerfile Front - Operación ULTRA-SLIM (Zero-Scripts)
FROM node:20-alpine AS build
WORKDIR /app

# Copia de manifiestos estructurados
COPY package*.json ./
COPY backend/package*.json ./backend/

# Instalación limpia y reproducible respetando los workspaces
RUN --mount=type=cache,target=/root/.npm \
    npm install --legacy-peer-deps --no-audit --ignore-scripts --prefer-offline

COPY . .
# Forzamos a Vite a no generar sourcemaps ni workers paralelos para no agotar la RAM
# max-old-space-size=640: deja ~360MB libres para OS + Docker en un droplet de 1GB
ENV NODE_OPTIONS="--max-old-space-size=4096" \
    GENERATE_SOURCEMAP=false \
    VITE_BUILD_SOURCEMAP=false \
    NODE_ENV=production
RUN npm run build

# Producción
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
