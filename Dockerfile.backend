# Stage 1: Build (Alpine ULTRA-SLIM Zero-Scripts)
FROM node:20-alpine AS builder
WORKDIR /app

# Inmunidad Total: Ignoramos scripts y optimizamos capas para ahorro de disco
# Copia de manifiestos estructurados por workspace
COPY package*.json ./
COPY backend/package*.json ./backend/

# Instalación declarativa del workspace backend sin manipulación ad-hoc de dependencias
RUN --mount=type=cache,target=/root/.npm \
    npm install --workspace=m7-backend --include-workspace-root --legacy-peer-deps --no-audit --ignore-scripts --prefer-offline

COPY . .
# Compilamos el servidor con límite de RAM optimizado y podamos devDependencies del workspace
ENV NODE_OPTIONS="--max-old-space-size=768"
RUN npm run build:server && \
    npm prune --workspace=m7-backend --omit=dev --legacy-peer-deps


# Stage 2: Production (Minimal Alpine)
FROM node:20-alpine
WORKDIR /app

# Instalación minimalista de sistema
RUN apk add --no-cache ca-certificates tzdata rclone ghostscript poppler-utils \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ttf-freefont \
      font-noto-emoji \
      wqy-zenhei

ENV NODE_ENV=production \
    TZ=America/Bogota \
    NODE_OPTIONS="--max-old-space-size=768" \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copiamos package.json por referencia
COPY package*.json ./
COPY backend/package*.json ./backend/

# COPIA DIRECTA DE ARTEFACTOS PROCESADOS
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist_backend ./dist_backend
COPY --from=builder /app/components ./components
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/public ./public
# Permisos y usuario de ejecución no-root para máxima seguridad
RUN mkdir -p /app/storage /app/public /app/backend/config/keys && \
    chown -R node:node /app

USER node

EXPOSE 8080

# Ejecutamos con node directamente
CMD ["node", "--max-old-space-size=768", "dist_backend/server.js"]
